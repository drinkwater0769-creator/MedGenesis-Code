{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClinicalRepBench Target Metrics",
  "type": "object",
  "required": ["metrics"],
  "properties": {
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "value", "tolerance_abs", "weight"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "value": { "type": "number" },
          "tolerance_abs": { "type": "number", "minimum": 0 },
          "weight": { "type": "number", "minimum": 0 },
          "direction": {
            "type": "string",
            "enum": ["higher_better", "lower_better", "target_match"]
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
